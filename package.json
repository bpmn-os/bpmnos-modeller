{
  "name": "bpmnos-modeller",
  "version": "0.0.0",
  "description": "A BPMN modeller for optimization and simulation",
  "main": "src/app.js",
  "scripts": {
    "all": "run-s bundle",
    "dev": "run-s bundle:less watch:js",
    "start": "run-s bundle serve",
    "serve": "sirv dist --dev",
    "bundle": "run-s bundle:*",
    "bundle:less": "lessc src/app.less dist/app.css",
    "bundle:js": "webpack -c webpack.config.js",
    "watch:js": "run-s \"bundle:js -- --watch\""
  },
  "author": {
    "name": "Asvin Goel"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "bpmn-js": "^18.3.1",
    "bpmn-moddle": "^9.0.1",
    "diagram-js": "^15.2.4",
    "bpmn-js-properties-panel": "^5.34.1",
    "@bpmn-io/properties-panel": "^3.26.3",
    "bpmn-js-bpmnlint": "^0.21.0",
    "bpmnlint-utils": "^1.1.1",
    "bpmn-js-collapse-event-subprocess": "^0.2.2",
    "bpmn-js-sequential-adhoc-subprocesses": "^0.1.0",
    "bpmn-js-subprocess-importer": "^0.2.1",
    "bpmn-js-token-simulation": "^0.38.0",
    "tiny-svg": "^3.1.2",
    "puppeteer-core": "^24.4.0",
    "chrome-launcher": "^1.1.2",
    "@xmldom/xmldom": "^0.9.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "less": "^4.2.2",
    "less-loader": "^12.2.0",
    "npm-run-all": "^4.1.5",
    "patch-package": "^6.4.7",
    "raw-loader": "^4.0.2",
    "sirv-cli": "^3.0.1",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "bin": {
    "bpmn2svg": "./bpmn2svg.js"
  }
}
